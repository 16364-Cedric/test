<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Couleurs et typographie de la charte NTN : voir brand.xml et docs/charte-graphique.md. -->
    <style name="Theme.Dati" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSurface">@color/brand_text</item>
        <item name="colorOnBackground">@color/brand_text</item>
        <item name="colorSurface">@color/brand_background</item>
        <item name="android:colorBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="actionBarStyle">@style/Widget.Dati.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
        <!-- Titres en Quicksand (charte p. 11) ; le texte courant garde la police du système,
             la Helvetica préconisée n'étant pas intégrable sans licence. -->
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Dati.HeadlineMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Dati.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Dati.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Dati.TitleSmall</item>
    </style>

    <!-- Barre de titre : aplat dégradé bleu → violet, titre en Quicksand blanc. -->
    <style name="Widget.Dati.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@drawable/brand_gradient</item>
        <item name="titleTextStyle">@style/TextAppearance.Dati.ActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TextAppearance.Dati.ActionBarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="fontFamily">@font/quicksand_bold</item>
    </style>

    <style name="TextAppearance.Dati.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="fontFamily">@font/quicksand_bold</item>
    </style>

    <style name="TextAppearance.Dati.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="fontFamily">@font/quicksand_bold</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <style name="TextAppearance.Dati.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="fontFamily">@font/quicksand_bold</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <style name="TextAppearance.Dati.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="fontFamily">@font/quicksand_bold</item>
    </style>

    <!-- Écran d'alarme : rouge de sécurité, hors charte, volontairement. -->
    <style name="Theme.Dati.Alarm" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/dati_red</item>
        <item name="android:windowBackground">@color/dati_red</item>
        <item name="android:statusBarColor">@color/dati_red</item>
    </style>
</resources>
